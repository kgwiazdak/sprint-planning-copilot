APP_PROFILE='prod'
MOCK_LLM='1'
DB_URL='sqlite:///./app.db'
DB_PROVIDER='cosmos'
COSMOS_ACCOUNT_URI=
COSMOS_KEY=
COSMOS_DB_NAME='sprint-planning-copilot'
COSMOS_MEETINGS_CONTAINER='meetings'
COSMOS_TASKS_CONTAINER='tasks'
COSMOS_USERS_CONTAINER='users'
COSMOS_RUNS_CONTAINER='extraction_runs'
ENABLE_MOCK_AUDIO=
MOCK_AUDIO_BLOB_PATH='mock/team_meeting.mp3'
MOCK_AUDIO_LOCAL_DIR='/data'
MOCK_AUDIO_LOCAL_FILENAME='team_meeting.mp3'

# F2 (przykład)
AZURE_OPENAI_API_VERSION='2024-02-15-preview'
AZURE_OPENAI_DEPLOYMENT='gpt-4o-mini-prod'
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT='https://krzys-mhi38uau-eastus2.cognitiveservices.azure.com/'

AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION='eastus'
AZURE_SPEECH_ENDPOINT='https://eastus.api.cognitive.microsoft.com/'

AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=
AZURE_STORAGE_CONTAINER_WORKERS=
# Alternatively provide account URL + SAS if you cannot use a connection string
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_SAS_TOKEN=

ELEVENLABS_API_KEY=

# MLflow tracking (optional but required for logging runs)
MLFLOW_TRACKING_URI=
MLFLOW_EXPERIMENT_NAME='ai-scrum-copilot-mvp'
MLFLOW_API_TOKEN=

JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY =
JIRA_STORY_POINTS_FIELD=

AZURE_STORAGE_QUEUE_NAME
  - AZURE_STORAGE_QUEUE_CONNECTION_STRING (or let it inherit from the blob connection string)
  - MEETING_QUEUE_VISIBILITY_TIMEOUT
  - MEETING_QUEUE_POLL_INTERVAL
  - MEETING_QUEUE_MAX_BATCH
  - AZURE_AD_TENANT_ID
  - AZURE_AD_CLIENT_ID
  - AZURE_AD_AUDIENCE
  - AZURE_AD_SCOPES
  - AZURE_AD_JWKS_URL (or AZURE_AD_JWKS)
  - AZURE_AD_REQUIRE_AUTH
  - VITE_AZURE_AD_CLIENT_ID
  - VITE_AZURE_AD_TENANT_ID
  - VITE_AZURE_AD_SCOPES

# Agentic runtime (LangGraph + LangSmith)
AGENT_RUNTIME='langgraph'
AGENT_GRAPH_ID='meeting_orchestrator_v1'
AGENT_ENABLE_SUPERVISOR='true'
AGENT_MAX_STEPS='30'
AGENT_MAX_PARALLEL_BRANCHES='4'
AGENT_STEP_TIMEOUT_SECONDS='120'
AGENT_CONFIDENCE_THRESHOLD='0.75'
AGENT_MAX_LOW_CONF_TASK_RATIO='0.5'
AGENT_ENABLE_HITL='true'
AGENT_APPROVAL_REQUIRED_FOR_JIRA_PUSH='true'
AGENT_AUTO_PUSH_TO_JIRA='false'
AGENT_PLANNER_MODEL='gpt-4o-mini'
AGENT_CRITIC_MODEL='gpt-4o-mini'

LANGSMITH_TRACING='true'
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT='https://api.smith.langchain.com'
LANGSMITH_PROJECT='sprint-planning-copilot'
LANGCHAIN_TRACING_V2='true'
LANGCHAIN_PROJECT='sprint-planning-copilot'

MCP_ENABLED='true'
MCP_ALLOWED_SERVERS='atlassian,confluence,filesystem'

