# =============================================================================
# Sprint Planning Copilot - Production Environment Configuration
# =============================================================================
# This configuration is for Azure production deployment with:
# - Azure Cosmos DB database
# - Azure Container Apps deployment
# - Mock file button ENABLED (for demo/testing purposes)
# - Real Azure AI services (no mocks)
# =============================================================================

# -----------------------------------------------------------------------------
# Application Profile
# -----------------------------------------------------------------------------
APP_PROFILE='prod'

# Disable all mocks - use real Azure services
MOCK_LLM='0'
MOCK_TRANSCRIBER='0'

# Enable mock audio file button for demo/testing
ENABLE_MOCK_AUDIO='1'
MOCK_AUDIO_BLOB_PATH='mock/team_meeting.mp3'
MOCK_AUDIO_LOCAL_DIR='/data'
MOCK_AUDIO_LOCAL_FILENAME='team_meeting.mp3'

# -----------------------------------------------------------------------------
# Database Configuration (Azure Cosmos DB)
# -----------------------------------------------------------------------------
DB_PROVIDER='cosmos'
COSMOS_ACCOUNT_URI='https://your-cosmos-account.documents.azure.com:443/'
COSMOS_KEY='your-cosmos-primary-key'
COSMOS_DB_NAME='sprint-planning-copilot'
COSMOS_MEETINGS_CONTAINER='meetings'
COSMOS_TASKS_CONTAINER='tasks'
COSMOS_USERS_CONTAINER='users'
COSMOS_RUNS_CONTAINER='extraction_runs'

# -----------------------------------------------------------------------------
# Azure OpenAI (Task Extraction) - REQUIRED
# -----------------------------------------------------------------------------
AZURE_OPENAI_ENDPOINT='https://your-resource.openai.azure.com/'
AZURE_OPENAI_DEPLOYMENT='gpt-4o-mini'
AZURE_OPENAI_API_KEY='your-azure-openai-api-key'
AZURE_OPENAI_API_VERSION='2024-02-15-preview'

# -----------------------------------------------------------------------------
# Azure Speech Services (Transcription) - REQUIRED
# -----------------------------------------------------------------------------
AZURE_SPEECH_KEY='your-azure-speech-key'
AZURE_SPEECH_REGION='eastus'
AZURE_SPEECH_ENDPOINT='https://eastus.api.cognitive.microsoft.com/'

# -----------------------------------------------------------------------------
# Azure Blob Storage (File Uploads) - REQUIRED
# -----------------------------------------------------------------------------
AZURE_STORAGE_CONNECTION_STRING='DefaultEndpointsProtocol=https;AccountName=your-account;AccountKey=your-key;EndpointSuffix=core.windows.net'
AZURE_STORAGE_CONTAINER_NAME='jiracopilot'
AZURE_STORAGE_CONTAINER_WORKERS='workers'

# -----------------------------------------------------------------------------
# Azure Storage Queue (Background Processing) - REQUIRED
# -----------------------------------------------------------------------------
AZURE_STORAGE_QUEUE_NAME='queue'
MEETING_QUEUE_VISIBILITY_TIMEOUT=300
MEETING_QUEUE_POLL_INTERVAL=2.0
MEETING_QUEUE_MAX_BATCH=16

# -----------------------------------------------------------------------------
# MLflow (Telemetry & Experiment Tracking)
# -----------------------------------------------------------------------------
# Production MLflow server (Azure Container Apps internal endpoint)
MLFLOW_TRACKING_URI='https://your-mlflow.internal.azurecontainerapps.io'
MLFLOW_EXPERIMENT_NAME='ai-scrum-copilot-mvp'
MLFLOW_API_TOKEN=

# -----------------------------------------------------------------------------
# Jira Integration (Optional)
# -----------------------------------------------------------------------------
JIRA_BASE_URL='https://your-company.atlassian.net'
JIRA_EMAIL='your-email@company.com'
JIRA_API_TOKEN='your-jira-api-token'
JIRA_PROJECT_KEY='SCRUM'
JIRA_STORY_POINTS_FIELD=

# -----------------------------------------------------------------------------
# Azure AD Authentication - REQUIRED for production
# -----------------------------------------------------------------------------
AZURE_AD_REQUIRE_AUTH='true'
AZURE_AD_TENANT_ID='your-tenant-id'
AZURE_AD_CLIENT_ID='your-backend-client-id'
AZURE_AD_AUDIENCE='api://your-backend-client-id'
AZURE_AD_SCOPES='api://your-backend-client-id/api.access'

# Frontend Azure AD Configuration
VITE_AZURE_AD_CLIENT_ID='your-frontend-client-id'
VITE_AZURE_AD_TENANT_ID='your-tenant-id'
VITE_AZURE_AD_SCOPES='api://your-backend-client-id/api.access'

# -----------------------------------------------------------------------------
# ElevenLabs (Optional - Text-to-Speech)
# -----------------------------------------------------------------------------
ELEVENLABS_API_KEY=

# -----------------------------------------------------------------------------
# Agentic Runtime (LangGraph + LangSmith)
# -----------------------------------------------------------------------------
LLM_PROVIDER='openai'
OPENAI_API_KEY='your-openai-api-key'
OPENAI_MODEL='gpt-4o-mini'
AGENT_RUNTIME='langgraph'
AGENT_GRAPH_ID='meeting_orchestrator_v1'
AGENT_ENABLE_SUPERVISOR='true'
AGENT_CONFIDENCE_THRESHOLD='0.75'
AGENT_MAX_LOW_CONF_TASK_RATIO='0.5'
AGENT_ENABLE_HITL='true'
AGENT_APPROVAL_REQUIRED_FOR_JIRA_PUSH='true'
AGENT_AUTO_PUSH_TO_JIRA='false'
AGENT_PLANNER_MODEL='gpt-4o-mini'
AGENT_CRITIC_MODEL='gpt-4o-mini'

LANGSMITH_TRACING='true'
LANGSMITH_API_KEY='your-langsmith-api-key'
LANGSMITH_ENDPOINT='https://api.smith.langchain.com'
LANGSMITH_PROJECT='sprint-planning-copilot-prod'
LANGCHAIN_TRACING_V2='true'
LANGCHAIN_PROJECT='sprint-planning-copilot-prod'

MCP_ENABLED='true'
MCP_ALLOWED_SERVERS='atlassian,confluence,filesystem'
