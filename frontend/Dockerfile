FROM node:22-alpine AS builder
WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

ARG VITE_API_URL
ARG VITE_APP_PROFILE
ARG VITE_ATLASSIAN_CLIENT_ID
ARG VITE_ATLASSIAN_REDIRECT_URI
ARG VITE_ATLASSIAN_SCOPES
ENV VITE_API_URL=${VITE_API_URL}
ENV VITE_APP_PROFILE=${VITE_APP_PROFILE}
ENV VITE_ATLASSIAN_CLIENT_ID=${VITE_ATLASSIAN_CLIENT_ID}
ENV VITE_ATLASSIAN_REDIRECT_URI=${VITE_ATLASSIAN_REDIRECT_URI}
ENV VITE_ATLASSIAN_SCOPES=${VITE_ATLASSIAN_SCOPES}

RUN npm run build

FROM nginx:stable-alpine
COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 4173
CMD ["nginx", "-g", "daemon off;"]
